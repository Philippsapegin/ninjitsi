# Base URL of the self-hosted Jitsi deployment.
# Leave empty to use the built-in visual demo mode.
NEXT_PUBLIC_JITSI_URL=https://meet.example.com

# Docker Compose reads these at container start; no rebuild is required.
JITSI_URL=https://meet.example.com
NINJITSI_PORT=127.0.0.1:3000

# Production admission: use the same values in docker-jitsi-meet.
JITSI_AUTH_MODE=token
JITSI_JWT_APP_ID=ninjitsi
JITSI_JWT_AUDIENCE=ninjitsi
JITSI_JWT_SUBJECT=meet.jitsi
JITSI_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JITSI_JWT_TTL_SECONDS=43200

# Persistent room registry settings.
MAX_ROOMS=10000
ROOM_TTL_HOURS=720

# Abuse protection. Defaults are suitable for a small public instance.
ROOM_CREATE_RATE_LIMIT=10
ROOM_CREATE_RATE_WINDOW_SECONDS=600
ROOM_CREATE_GLOBAL_RATE_LIMIT=120
ROOM_JOIN_RATE_LIMIT=30
ROOM_JOIN_GLOBAL_RATE_LIMIT=600
ROOM_PASSWORD_RATE_LIMIT=10
ROOM_LOOKUP_RATE_LIMIT=120
SCRYPT_MAX_CONCURRENCY=2
SCRYPT_MAX_QUEUE=8
