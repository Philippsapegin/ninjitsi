# Base URL of the self-hosted Jitsi deployment.
# Leave empty to use the built-in visual demo mode.
NEXT_PUBLIC_JITSI_URL=https://meet.example.com

# Docker Compose reads these at container start; no rebuild is required.
JITSI_URL=https://meet.example.com
NINJITSI_PORT=3000

# Persistent room registry settings.
DATA_DIR=.data
MAX_ROOMS=10000
