{
  "name": "ninjitsi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/make-static-worker.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "start": "node server/server.mjs",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke:rooms": "node scripts/room-smoke.mjs",
    "smoke:visual": "node scripts/visual-smoke.mjs",
    "smoke:jitsi": "node scripts/jitsi-smoke.mjs",
    "smoke:profiles": "node scripts/profile-smoke.mjs",
    "stack:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stack.ps1 prepare",
    "stack:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stack.ps1 up",
    "stack:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stack.ps1 down",
    "stack:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stack.ps1 status"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.5",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "undici": "^7.29.0"
  }
}
